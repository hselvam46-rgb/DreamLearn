# DreamLearn Server - Environment Configuration Example
# Copy this file to .env and adjust values for your deployment environment

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String:
# - Leave empty to use the zero-setup embedded in-memory database (great for immediate testing/demos)
# - Or provide your MongoDB Atlas / self-hosted MongoDB URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dreamlearn?retryWrites=true&w=majority
# MONGODB_URI=mongodb://localhost:27017/dreamlearn
# MONGODB_URI=mongodb://mongo:27017/dreamlearn (for Docker Compose)
MONGODB_URI=

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=dreamlearn_jwt_secret_super_secure_key_2026

# Allowed CORS Origins (Comma-separated or * for all)
CORS_ORIGIN=*

# Rate Limiting & Sandbox Constraints (Optional)
COMPILER_TIMEOUT_MS=10000
COMPILER_MAX_BUFFER_KB=1024
