# DreamLearn Client - Environment Configuration Example
# Copy this file to .env or .env.local to customize for production deployments

# If frontend and backend are hosted on different domains (e.g. Vercel + Render):
# Set this to the backend API base URL including /api/v1
# VITE_API_URL=https://api.yourdomain.com/api/v1

# For local development with Vite dev server (leave empty to use local Vite proxy):
# VITE_API_URL=/api/v1
